{
  "name": "@isomorphic.schema/utils",
  "private": true,
  "version": "1.0.0",
  "description": "Shared route utilities for the server side of @isomorphic.schema middleware.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkutianski/utils.schema.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "LICENSE",
    "src"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:types": "tsc --noEmit --project tsconfig.types.json"
  },
  "license": "MIT",
  "author": {
    "name": "Juan Pablo Kutianki",
    "email": "jutianski@gmail.com"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/node": "^24.0.0",
    "jest": "^30.5.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  }
}
